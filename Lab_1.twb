      <aliases enabled='yes' />
      <column caption='Review Performance Score' datatype='integer' name='[Calculation_0095151360208897]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Number Of Reviews]*[Review Scores Rating]' />
      </column>
      <column caption='Price Category' datatype='string' name='[Calculation_0095151360864258]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price]&gt;= 300 THEN &quot;Luxary&quot;&#13;&#10;ELSEIF [Price]&gt;=150 THEN &quot;Standard&quot;&#13;&#10;ELSE &quot;Budget&quot;&#13;&#10;END' />
      </column>
      <column caption='Review  Category' datatype='string' name='[Calculation_0095151362027523]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Number Of Reviews]&gt;= 100 THEN &quot;Highly Reviewed&quot;&#13;&#10;ELSE&quot;Less Reviewed&quot;&#13;&#10;END' />
      </column>
      <column caption='Host Status' datatype='string' name='[Calculation_0095151363223556]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Host Since] &lt;=TODAY() THEN &quot;Active Host&quot;&#13;&#10;ELSE &quot;New Host&quot;&#13;&#10;END' />
      </column>
      <column caption='Activity - 1' datatype='integer' name='[Calculation_0095151363674117]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Price] * [Beds]' />
      </column>
      <column caption='Activity - 2' datatype='string' name='[Calculation_0095151364476934]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Review Scores Rating] &gt;= 90 THEN &quot;Excellent&quot;&#13;&#10;ELSEIF [Review Scores Rating] &gt;= 80 THEN &quot;Good&quot;&#13;&#10;ELSEIF [Review Scores Rating] &gt;= 70 THEN &quot;Average&quot;&#13;&#10;ELSE &quot;Poor&quot;&#13;&#10;END' />
      </column>
      <column caption='Activity - 3' datatype='string' name='[Calculation_0095151365283847]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt;= 500 THEN &quot;Expensive&quot;&#13;&#10;ELSE &quot;Affordable&quot;&#13;&#10;END' />
      </column>
      <column caption='Price Filter Category' datatype='string' name='[Calculation_0095151368847370]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Price] &gt; [Parameters].[Parameter 0095151367921673] THEN &quot;Above Limit&quot;&#13;&#10;ELSE &quot;below Limit&quot;&#13;&#10;END' />
      </column>
      <column caption='Review Score Limit' datatype='string' name='[Calculation_0095151370055692]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Review Scores Rating] &gt;= [Parameters].[Parameter 0095151369502731] THEN&#13;&#10;    &quot;Good Rating&quot;&#13;&#10;ELSE&#13;&#10;    &quot;Low Rating&quot;&#13;&#10;END' />
      </column>
